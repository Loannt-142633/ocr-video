{
  "manifest_version": 2,
  "name": "Cơm — OCR phụ đề",
  "version": "0.1.0",
  "description": "Chọn vùng chữ trên video, đọc phụ đề bằng OCR local và tùy chọn dịch qua backend local.",
  "permissions": ["activeTab", "storage", "http://127.0.0.1:8787/*"],
  "background": {"page": "background.html", "persistent": true},
  "browser_action": {"default_title": "Bật OCR phụ đề"},
  "browser_specific_settings": {"gecko": {"id": "subtitle-ocr@com.local", "strict_min_version": "128.0"}},
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' http://127.0.0.1:8787"
}
